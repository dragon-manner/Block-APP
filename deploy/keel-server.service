[Unit]
Description=Keel sync server
After=network-online.target
Wants=network-online.target

[Service]
User=keel
Group=keel
WorkingDirectory=/var/lib/keel
# HTTPS on :443 with a Let's Encrypt certificate for the sslip.io name of the VPS's IP.
# Change -domain if you point a real domain at the box.
ExecStart=/usr/local/bin/keel-server -domain 144-31-38-244.sslip.io -db /var/lib/keel/keel.db -certs /var/lib/keel/certs
Restart=always
RestartSec=3
# Binding 80/443 without running as root.
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/var/lib/keel
# The box has 1GB shared with other services; Keel idles around 10-15MB.
MemoryMax=128M
Environment=GOMEMLIMIT=96MiB

[Install]
WantedBy=multi-user.target
