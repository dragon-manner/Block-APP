{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Keel",
  "version": "2.0.0",
  "identifier": "app.keel.desktop",
  "build": {
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Keel",
        "width": 1180,
        "height": 820,
        "minWidth": 380,
        "minHeight": 560,
        "visible": false,
        "backgroundColor": "#0E0F0C"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["deb", "rpm", "appimage", "nsis", "msi"],
    "category": "Productivity",
    "shortDescription": "Screen time, limits and focus across every device",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "resources": { "catalog.json": "catalog.json" },
    "linux": { "deb": { "depends": [] } }
  }
}
