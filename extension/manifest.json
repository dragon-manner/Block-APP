{
  "manifest_version": 3,
  "name": "Keel",
  "version": "2.0.0",
  "description": "Counts reels and walls blocked sites for Keel, against the same limits as your phone.",
  "icons": { "16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png" },
  "background": { "service_worker": "background.js", "scripts": ["background.js"] },
  "permissions": ["storage", "activeTab"],
  "host_permissions": ["http://127.0.0.1:47321/*"],
  "content_scripts": [
    { "matches": ["<all_urls>"], "js": ["content.js"], "run_at": "document_start", "all_frames": false }
  ],
  "action": { "default_title": "Keel", "default_popup": "popup.html", "default_icon": { "16": "icons/icon16.png", "32": "icons/icon32.png" } },
  "browser_specific_settings": { "gecko": { "id": "keel@keel.app", "strict_min_version": "121.0" } }
}
